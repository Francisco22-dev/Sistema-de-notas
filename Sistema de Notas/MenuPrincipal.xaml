<Window x:Class="SistemaLiceo.Presentacion.MenuPrincipal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Panel de Control - Sistema Liceo" Height="720" Width="1080"
        WindowStartupLocation="CenterScreen" Background="#F3F4F6">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#1E3A8A">
            <StackPanel Margin="15">
                <TextBlock Text="🏫 Liceo App" Foreground="White" FontSize="26" FontWeight="Bold" Margin="0,20,0,5" HorizontalAlignment="Center"/>

                <TextBlock x:Name="txtUsuarioInfo" Foreground="#9CA3AF" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <!-- En el StackPanel izquierdo de MenuPrincipal.xaml -->
                <Button x:Name="btnEstudiantes" Click="btnEstudiantes_Click" Content="👨‍🎓 Estudiantes" Height="45" Margin="0,5" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" Cursor="Hand"/>
                <Button x:Name="btnProfesores" Click="btnProfesores_Click" Content="👩‍🏫 Profesores" Height="45" Margin="0,5" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" Cursor="Hand"/>
                <Button x:Name="btnMaterias" Click="btnMaterias_Click" Content="📖 Materias" Height="45" Margin="0,5" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" Cursor="Hand"/>
                <Button x:Name="btnNotas" Click="btnNotas_Click" Content="📝 Notas y Lapsos" Height="45" Margin="0,5" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" Cursor="Hand"/>
                <Button x:Name="btnReportes" Click="btnReportes_Click" Content="📊 Reportes y Constancias" Height="45" Margin="0,5" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" Cursor="Hand"/>
                <Button x:Name="btnUsuarios" Click="btnUsuarios_Click" Content="👥 Gestión de Usuarios" Height="45" Margin="0,4" Background="Transparent" Foreground="White" FontSize="16" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,0,0,0" Cursor="Hand"/>

                <Border Height="1" Background="#3B82F6" Margin="20,50,20,20"/>

                <Button x:Name="btnCerrarSesion" Content="🚪 Cerrar Sesión" Height="45" Background="#EF4444" Foreground="White" FontSize="16" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCerrarSesion_Click">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="8"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="20" Background="White" CornerRadius="10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" ShadowDepth="1" Color="LightGray" Opacity="0.3"/>
            </Border.Effect>

            <ContentControl x:Name="ContenedorPrincipal" Margin="15"/>
        </Border>
    </Grid>
</Window>