<Window x:Class="SistemaLiceo.Presentacion.ProfesorForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Registrar Nuevo Docente" Height="420" Width="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Border Background="White" CornerRadius="12" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Ficha de Registro Docente" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,15"/>

            <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,10">
                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Nacionalidad *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbNacionalidad" SelectedIndex="0" Height="30" Margin="0,0,0,8">
                        <ComboBoxItem Content="V"/>
                        <ComboBoxItem Content="E"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Cédula de Identidad *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtCedula" Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Primer Nombre *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNombre1" Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Segundo Nombre" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNombre2" Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Primer Apellido *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtApellido1" Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Segundo Apellido" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtApellido2" Height="30" Margin="0,0,0,8" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Margin="0,0,10,0">
                    <TextBlock Text="Fecha de Nacimiento" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <DatePicker x:Name="dpFechaNacimiento" Height="30" Margin="0,0,0,8"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Sexo *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <ComboBox x:Name="cmbSexo" SelectedIndex="0" Height="30" Margin="0,0,0,8">
                        <ComboBoxItem Content="M"/>
                        <ComboBoxItem Content="F"/>
                    </ComboBox>
                </StackPanel>
            </UniformGrid>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="32" Margin="0,0,10,0"
                        Background="#9CA3AF" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnCancelar_Click"/>
                <Button x:Name="btnGuardar" Content="Guardar Profesor" Width="140" Height="32"
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>