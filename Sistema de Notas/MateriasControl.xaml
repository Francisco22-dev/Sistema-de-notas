<UserControl x:Class="SistemaLiceo.Presentacion.MateriasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Gestión del Plan de Materias" FontSize="24" FontWeight="Bold" Foreground="#1F2937" Margin="0,0,0,15"/>

        <!-- Panel de Creación / Edición -->
        <Border Grid.Row="1" Background="#F8FAFC" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" Padding="15" Margin="0,0,0,15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,15,0">
                    <TextBlock Text="Nombre de la Materia / Asignatura:" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <TextBox x:Name="txtNombreMateria" Height="32" VerticalContentAlignment="Center"/>
                </StackPanel>

                <Button x:Name="btnGuardarMateria" Grid.Column="1" Content="💾 Guardar" Width="110" Height="32"
                        Background="#10B981" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"
                        VerticalAlignment="Bottom" BorderThickness="0" Cursor="Hand" Click="btnGuardarMateria_Click"/>

                <Button x:Name="btnCancelarEdicion" Grid.Column="2" Content="Cancelar" Width="90" Height="32"
                        Background="#9CA3AF" Foreground="White" FontWeight="Bold" Margin="0,0,8,0"
                        VerticalAlignment="Bottom" BorderThickness="0" Cursor="Hand" Visibility="Collapsed" Click="btnCancelarEdicion_Click"/>

                <Button x:Name="btnEliminarMateria" Grid.Column="3" Content="🗑️ Eliminar" Width="100" Height="32"
                        Background="#EF4444" Foreground="White" FontWeight="Bold"
                        VerticalAlignment="Bottom" BorderThickness="0" Cursor="Hand" Click="btnEliminarMateria_Click"/>
            </Grid>
        </Border>

        <!-- Listado de Materias -->
        <DataGrid x:Name="gridMaterias" Grid.Row="2" AutoGenerateColumns="False"
                  IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                  Background="White" BorderBrush="#D1D5DB" BorderThickness="1"
                  RowHeight="35" FontSize="14" AlternatingRowBackground="#F9FAFB"
                  SelectionChanged="gridMaterias_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="100"/>
                <DataGridTextColumn Header="Nombre de la Asignatura" Binding="{Binding Nombre}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>