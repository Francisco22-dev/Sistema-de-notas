<UserControl x:Class="SistemaLiceo.Presentacion.NotasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <!-- Estilo de Encabezado Excel -->
        <Style x:Key="HeaderExcelStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para la celda amarilla de Definitiva -->
        <Style x:Key="CeldaDefinitivaStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FEF08A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CeldaCentradaStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
<RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ================= 1. CABECERA INSTITUCIONAL (Estilo Planilla) ================= -->
        <Border Grid.Row="0" Background="White" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Icono/Escudo Institucional -->
                <TextBlock Grid.Column="0" Text="🏫" FontSize="42" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <!-- Textos Centrales del Plantel -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="UNIDAD EDUCATIVA CARABOBO" FontWeight="Black" FontSize="18" Foreground="#0F172A"/>
                    <TextBlock Text="Departamento de Control de Estudios y Evaluación" FontSize="13" Foreground="#475569" FontWeight="SemiBold"/>
                    <TextBlock Text="Código Plantel: S0207D0814 - VALENCIA, CARABOBO" FontSize="12" Foreground="#64748B"/>
                </StackPanel>

                <!-- Cuadros Laterales de Año Escolar y Momento -->
                <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Padding="8" CornerRadius="4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Momento:" FontWeight="Bold" FontSize="12"/>
                            <ComboBox x:Name="cmbLapso" HorizontalAlignment="Right" Width="120" Height="24" SelectedIndex="0" SelectionChanged="cmbLapso_SelectionChanged">
                                <ComboBoxItem Content="I Momento"/>
                                <ComboBoxItem Content="II Momento"/>
                                <ComboBoxItem Content="III Momento"/>
                                <ComboBoxItem Content="Reparación"/>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Año Escolar:" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbPeriodo" HorizontalAlignment="Right" Width="120" Height="24" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectionChanged="cmbPeriodo_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= 2. BARRA DE SELECCIÓN DOCENTE Y NOMBRES DE EVALUACIONES ================= -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Selección de Carga Académica -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Asignación Académica (Grado / Sección / Materia / Docente):" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox x:Name="cmbCargaAcademica" Grid.Column="1" Height="28" SelectedValuePath="Id"/>

                    <Button x:Name="btnCargarPlanilla" Grid.Column="2" Content="🔍 Cargar Planilla" Height="28" Width="140"
                            Margin="10,0,0,0" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCargarPlanilla_Click"/>
                </Grid>

                <!-- Nombres Personalizados de las Evaluaciones (Columnas) -->
                <GroupBox Grid.Row="1" Header="Configuración de Actividades del Momento (Títulos de Columnas)" FontWeight="SemiBold" Padding="6">
                    <UniformGrid Columns="6">
                        <StackPanel Margin="3,0">
                            <TextBlock Text="Actividad 1 (20%):" FontSize="11"/>
                            <TextBox x:Name="txtEval1" Text="Nota 1" Height="24" TextChanged="NombresEvaluaciones_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="3,0">
                            <TextBlock Text="Actividad 2 (20%):" FontSize="11"/>
                            <TextBox x:Name="txtEval2" Text="Nota 2" Height="24" TextChanged="NombresEvaluaciones_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="3,0">
                            <TextBlock Text="Actividad 3 (20%):" FontSize="11"/>
                            <TextBox x:Name="txtEval3" Text="Nota 3" Height="24" TextChanged="NombresEvaluaciones_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="3,0">
                            <TextBlock Text="Actividad 4 (20%):" FontSize="11"/>
                            <TextBox x:Name="txtEval4" Text="Nota 4" Height="24" TextChanged="NombresEvaluaciones_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="3,0">
                            <TextBlock Text="Actividad 5 (10%):" FontSize="11"/>
                            <TextBox x:Name="txtEval5" Text="Nota 5" Height="24" TextChanged="NombresEvaluaciones_TextChanged"/>
                        </StackPanel>
                        <StackPanel Margin="3,0">
                            <TextBlock Text="Actividad 6 (10%):" FontSize="11"/>
                            <TextBox x:Name="txtEval6" Text="Rasgos" Height="24" TextChanged="NombresEvaluaciones_TextChanged"/>
                        </StackPanel>
                    </UniformGrid>
                </GroupBox>
            </Grid>
        </Border>

        <!-- ================= 3. GRILLA MATRICIAL ESTILO EXCEL ================= -->
        <DataGrid x:Name="gridPlanilla" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="White" BorderBrush="#0F172A" BorderThickness="1.5"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1"
                  RowHeight="32" FontSize="13" ColumnHeaderStyle="{StaticResource HeaderExcelStyle}"
                  SelectionUnit="Cell">

            <DataGrid.Columns>
                <!-- Nº Lista -->
                <DataGridTextColumn Header="№&#x0a;Lista" Binding="{Binding NroLista}" IsReadOnly="True" Width="45" CellStyle="{StaticResource CeldaCentradaStyle}"/>

                <!-- Cédula -->
                <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" IsReadOnly="True" Width="110" FontWeight="SemiBold" CellStyle="{StaticResource CeldaCentradaStyle}"/>

                <!-- Apellidos y Nombres -->
                <DataGridTextColumn Header="Apellidos y Nombres" Binding="{Binding ApellidosYNombres}" IsReadOnly="True" Width="*" FontWeight="SemiBold"/>

                <!-- 6 Columnas de Evaluaciones Editables -->
                <DataGridTextColumn x:Name="colEval1" Header="Actividad 1" Binding="{Binding Eval1, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval2" Header="Actividad 2" Binding="{Binding Eval2, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval3" Header="Actividad 3" Binding="{Binding Eval3, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval4" Header="Actividad 4" Binding="{Binding Eval4, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval5" Header="Actividad 5" Binding="{Binding Eval5, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval6" Header="Actividad 6" Binding="{Binding Eval6, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>

                <!-- Sumatoria Acumulada -->
                <DataGridTextColumn Header="Sumatoria" Binding="{Binding Sumatoria, StringFormat={}{0:N2}}" IsReadOnly="True" Width="85" FontWeight="Bold" CellStyle="{StaticResource CeldaCentradaStyle}"/>

                <!-- Definitiva Resaltada en Amarillo -->
                <DataGridTextColumn Header="Definitiva" Binding="{Binding Definitiva}" IsReadOnly="True" Width="85" CellStyle="{StaticResource CeldaDefinitivaStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- ================= 4. BOTONES DE ACCIÓN INFERIORES ================= -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <Grid>
                <TextBlock Text="💡 Ingrese las calificaciones de 0 a 20. La sumatoria y la definitiva se calculan automáticamente." VerticalAlignment="Center" Foreground="#64748B" FontSize="12"/>

            </Grid>
        </Border>
        <StackPanel  Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnImprimirPlanilla" Content="🖨️ Imprimir / PDF" Width="150" Height="34" Margin="0,0,10,0"
            Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnImprimirPlanilla_Click"/>

            <Button x:Name="btnGuardarPlanilla" Content="💾 Guardar Calificaciones" Width="190" Height="34"
            Background="#16A34A" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnGuardarPlanilla_Click"/>
        </StackPanel>
    </Grid>
</UserControl>