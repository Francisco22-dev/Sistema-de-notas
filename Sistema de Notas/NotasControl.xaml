<UserControl x:Class="SistemaLiceo.Presentacion.NotasControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F8FAFC">

    <UserControl.Resources>
        <Style x:Key="HeaderExcelStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#F1F5F9"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CeldaDefinitivaStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="#FEF08A"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#000000"/>
            <Setter Property="BorderBrush" Value="#15803D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>

        <Style x:Key="CeldaCentradaStyle" TargetType="DataGridCell">
            <Setter Property="TextBlock.TextAlignment" Value="Center"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Cabecera Institucional -->
        <Border Grid.Row="0" Background="White" BorderBrush="#94A3B8" BorderThickness="1.5" CornerRadius="4" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="🏫" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0">
                    <TextBlock Text="UNIDAD EDUCATIVA COLEGIO NUESTRA SEÑORA DE LOURDES" FontWeight="Black" FontSize="16" Foreground="#0F172A"/>
                    <TextBlock Text="Departamento de Control de Estudios y Evaluación | Sistema de Notas" FontSize="12" Foreground="#475569"/>
                </StackPanel>

                <Border Grid.Column="2" BorderBrush="#CBD5E1" BorderThickness="1" Background="#F8FAFC" Padding="6" CornerRadius="4">
                    <StackPanel>
                        <Grid Margin="0,0,0,4">
                            <TextBlock Text="Momento:" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbLapso" HorizontalAlignment="Right" Width="130" Height="24" SelectedIndex="0">
                                <ComboBoxItem Content="I Momento"/>
                                <ComboBoxItem Content="II Momento"/>
                                <ComboBoxItem Content="III Momento"/>
                                <ComboBoxItem Content="Reparación"/>
                            </ComboBox>
                        </Grid>
                        <Grid>
                            <TextBlock Text="Año Escolar:" FontWeight="Bold" FontSize="11" VerticalAlignment="Center"/>
                            <ComboBox x:Name="cmbPeriodo" HorizontalAlignment="Right" Width="130" Height="24" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectionChanged="cmbPeriodo_SelectionChanged"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Filtros Separados (Año, Sección, Materia y Docente) + Configuración de Porcentajes -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Fila 1: Filtros en Cascada Independientes -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Año / Grado:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbGrado" Height="28" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectionChanged="FiltroCascada_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Sección:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbSeccion" Height="28" DisplayMemberPath="Nombre" SelectedValuePath="Id" SelectionChanged="FiltroCascada_SelectionChanged"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,8,0">
                        <TextBlock Text="Asignatura y Profesor Asignado:" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,2"/>
                        <ComboBox x:Name="cmbDocenteMateria" Height="28" DisplayMemberPath="Display" SelectedValuePath="Id"/>
                    </StackPanel>

                    <Button x:Name="btnCargarPlanilla" Grid.Column="3" Content="🔍 Cargar Planilla" Height="28" Width="140"
                            VerticalAlignment="Bottom" Background="#3B82F6" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnCargarPlanilla_Click"/>
                </Grid>

                <!-- Fila 2: Título y Porcentajes Editables -->
                <GroupBox Grid.Row="1" Header="Plan de Evaluación (Actividades y Porcentajes a Voluntad)" FontWeight="SemiBold" Padding="6">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Títulos -->
                        <UniformGrid Grid.Row="0" Columns="6" Margin="0,0,0,4">
                            <TextBox x:Name="txtEval1" Text="Actividad 1" Height="24" Margin="2,0" TextChanged="Configuracion_TextChanged"/>
                            <TextBox x:Name="txtEval2" Text="Actividad 2" Height="24" Margin="2,0" TextChanged="Configuracion_TextChanged"/>
                            <TextBox x:Name="txtEval3" Text="Actividad 3" Height="24" Margin="2,0" TextChanged="Configuracion_TextChanged"/>
                            <TextBox x:Name="txtEval4" Text="Actividad 4" Height="24" Margin="2,0" TextChanged="Configuracion_TextChanged"/>
                            <TextBox x:Name="txtEval5" Text="Actividad 5" Height="24" Margin="2,0" TextChanged="Configuracion_TextChanged"/>
                            <TextBox x:Name="txtEval6" Text="Actividad 6" Height="24" Margin="2,0" TextChanged="Configuracion_TextChanged"/>
                        </UniformGrid>

                        <!-- Porcentajes (%) -->
                        <UniformGrid Grid.Row="1" Columns="6">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="%: " VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtPorc1" Text="20" Width="40" Height="22" TextAlignment="Center" TextChanged="Configuracion_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="%: " VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtPorc2" Text="20" Width="40" Height="22" TextAlignment="Center" TextChanged="Configuracion_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="%: " VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtPorc3" Text="20" Width="40" Height="22" TextAlignment="Center" TextChanged="Configuracion_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="%: " VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtPorc4" Text="20" Width="40" Height="22" TextAlignment="Center" TextChanged="Configuracion_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="%: " VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtPorc5" Text="10" Width="40" Height="22" TextAlignment="Center" TextChanged="Configuracion_TextChanged"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="%: " VerticalAlignment="Center" FontSize="11"/>
                                <TextBox x:Name="txtPorc6" Text="10" Width="40" Height="22" TextAlignment="Center" TextChanged="Configuracion_TextChanged"/>
                            </StackPanel>
                        </UniformGrid>
                    </Grid>
                </GroupBox>
            </Grid>
        </Border>

        <!-- Grilla de Planilla -->
        <DataGrid x:Name="gridPlanilla" Grid.Row="2" AutoGenerateColumns="False"
                  CanUserAddRows="False" CanUserDeleteRows="False"
                  Background="White" BorderBrush="#0F172A" BorderThickness="1.5"
                  GridLinesVisibility="All" HorizontalGridLinesBrush="#CBD5E1" VerticalGridLinesBrush="#CBD5E1"
                  RowHeight="32" FontSize="13" ColumnHeaderStyle="{StaticResource HeaderExcelStyle}"
                  SelectionUnit="Cell">
            <DataGrid.Columns>
                <DataGridTextColumn Header="№&#x0a;Lista" Binding="{Binding NroLista}" IsReadOnly="True" Width="45" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn Header="Cédula" Binding="{Binding Cedula}" IsReadOnly="True" Width="110" FontWeight="SemiBold" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn Header="Apellidos y Nombres" Binding="{Binding ApellidosYNombres}" IsReadOnly="True" Width="*" FontWeight="SemiBold"/>
                <DataGridTextColumn x:Name="colEval1" Header="Act. 1" Binding="{Binding Eval1, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval2" Header="Act. 2" Binding="{Binding Eval2, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval3" Header="Act. 3" Binding="{Binding Eval3, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval4" Header="Act. 4" Binding="{Binding Eval4, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval5" Header="Act. 5" Binding="{Binding Eval5, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn x:Name="colEval6" Header="Act. 6" Binding="{Binding Eval6, UpdateSourceTrigger=PropertyChanged, TargetNullValue=''}" Width="85" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn Header="Sumatoria" Binding="{Binding Sumatoria, StringFormat={}{0:N2}}" IsReadOnly="True" Width="85" FontWeight="Bold" CellStyle="{StaticResource CeldaCentradaStyle}"/>
                <DataGridTextColumn Header="Definitiva" Binding="{Binding Definitiva}" IsReadOnly="True" Width="85" CellStyle="{StaticResource CeldaDefinitivaStyle}"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Botones de Acción Inferiores -->
        <Border Grid.Row="3" Background="White" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,10,0,0">
            <Grid>
                <TextBlock x:Name="lblTotalPorcentaje" Text="Total Ponderación: 100%" VerticalAlignment="Center" FontWeight="Bold" Foreground="#059669" FontSize="13"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="btnImprimirPlanilla" Content="🖨️ Imprimir / PDF" Width="150" Height="34" Margin="0,0,10,0"
                            Background="#64748B" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnImprimirPlanilla_Click"/>
                    <Button x:Name="btnGuardarPlanilla" Content="💾 Guardar Calificaciones" Width="190" Height="34"
                            Background="#16A34A" Foreground="White" FontSize="14" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="btnGuardarPlanilla_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>