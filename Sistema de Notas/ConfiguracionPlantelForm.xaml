<Window x:Class="SistemaLiceo.Presentacion.ConfiguracionPlantelForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuración de Datos del Plantel y Epónimo" Height="530" Width="680"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize" Background="#F8FAFC">
    <Border Background="White" CornerRadius="10" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="🏛️ Datos Institucionales para Constancias y Certificaciones" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,15"/>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Denominación y Epónimo Oficial del Plantel:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtEponimo" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center" Text="UNIDAD EDUCATIVA CARABOBO"/>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Código del Plantel (DEA):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtCodigoPlantel" Height="30" Text="S0207D0814" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Código Plan de Estudio:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtCodigoPlan" Height="30" Text="31059" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Teléfono Institucional:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtTelefono" Height="30" Text="0241-8217287" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="Dirección Completa del Plantel:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                    <TextBox x:Name="txtDireccion" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center" Text="URBANIZACIÓN SAN JOSÉ, VALENCIA - ESTADO CARABOBO"/>

                    <UniformGrid Columns="3" Margin="0,0,0,10">
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Municipio:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtMunicipio" Height="30" Text="VALENCIA" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,8,0">
                            <TextBlock Text="Entidad Federal (Estado):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtEntidad" Height="30" Text="CARABOBO" VerticalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="CDCEE (Zona Educativa):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                            <TextBox x:Name="txtCdcee" Height="30" Text="CARABOBO" VerticalContentAlignment="Center"/>
                        </StackPanel>
                    </UniformGrid>

                    <GroupBox Header="Datos del Director(a) para Firmas y Sellos" Padding="8">
                        <UniformGrid Columns="2">
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="Nombre y Apellido del Director(a):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtDirectorNombre" Height="30" Text="MILAGROS DEL V. PEREZ DE V." VerticalContentAlignment="Center"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="Cédula de Identidad del Director(a):" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                <TextBox x:Name="txtDirectorCedula" Height="30" Text="V-18061830" VerticalContentAlignment="Center"/>
                            </StackPanel>
                        </UniformGrid>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="34" Margin="0,0,10,0"
                        Background="#94A3B8" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnCancelar_Click"/>
                <Button x:Name="btnGuardar" Content="💾 Guardar Cambios" Width="160" Height="34"
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>