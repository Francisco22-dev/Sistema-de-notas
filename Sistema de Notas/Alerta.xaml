<Window x:Class="SistemaLiceo.Presentacion.Alerta"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alerta" Height="250" Width="400"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" Topmost="True" ResizeMode="NoResize">

    <Border Background="White" CornerRadius="12" Margin="15">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="3" Color="Black" Opacity="0.2"/>
        </Border.Effect>

        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="txtTitulo" Text="Título" FontWeight="Bold" FontSize="20" Foreground="#1F2937"/>

            <TextBlock x:Name="txtMensaje" Text="Mensaje de notificación..." TextWrapping="Wrap" Foreground="#4B5563" FontSize="14" Grid.Row="1" Margin="0,15,0,15" VerticalAlignment="Center"/>

            <Button x:Name="btnAceptar" Content="Aceptar" Grid.Row="2" Height="35" Width="100" HorizontalAlignment="Right" Foreground="White" FontWeight="Bold" Cursor="Hand" Click="btnAceptar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="6"/>
                    </Style>
                </Button.Resources>
            </Button>
        </Grid>
    </Border>
</Window>