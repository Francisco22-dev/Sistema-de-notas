<Window x:Class="SistemaLiceo.Presentacion.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ingreso al Sistema" Height="450" Width="350" 
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="#F3F4F6">

    <Border Background="White" CornerRadius="15" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="15" ShadowDepth="2" Color="LightGray" Opacity="0.5"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <TextBlock Text="Sistema Liceo" FontSize="28" FontWeight="Bold" Foreground="#1E3A8A" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="Inicia sesión para continuar" FontSize="14" Foreground="#6B7280" HorizontalAlignment="Center" Margin="0,0,0,30"/>

            <TextBlock Text="Usuario" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
            <TextBox x:Name="txtUsuario" Height="35" Padding="5" FontSize="14" Margin="0,0,0,15" BorderBrush="#D1D5DB" BorderThickness="1"/>

            <TextBlock Text="Contraseña" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,5"/>
            <PasswordBox x:Name="txtClave" Height="35" Padding="5" FontSize="14" Margin="0,0,0,25" BorderBrush="#D1D5DB" BorderThickness="1"/>

            <Button x:Name="btnIngresar" Content="Ingresar" Height="40" Background="#1E3A8A" Foreground="White" FontSize="16" FontWeight="Bold" Cursor="Hand" Click="btnIngresar_Click">
                <Button.Resources>
                    <Style TargetType="Border">
                        <Setter Property="CornerRadius" Value="8"/>
                    </Style>
                </Button.Resources>
            </Button>

        </StackPanel>
    </Border>
</Window>