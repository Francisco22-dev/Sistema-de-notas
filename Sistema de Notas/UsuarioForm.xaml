<Window x:Class="SistemaLiceo.Presentacion.UsuarioForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestión de Usuario" Height="400" Width="450"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#F3F4F6">
    <Border Background="White" CornerRadius="12" Margin="15" Padding="20">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock x:Name="lblTitulo" Text="Registrar Nuevo Usuario" FontSize="18" FontWeight="Bold" Foreground="#1E3A8A" Margin="0,0,0,15"/>

            <StackPanel Grid.Row="1">
                <TextBlock Text="Nombre de Usuario *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <TextBox x:Name="txtNombre" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Rol en el Sistema *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbRol" Height="30" Margin="0,0,0,10" SelectedIndex="1">
                    <ComboBoxItem Content="Administrador"/>
                    <ComboBoxItem Content="Secretaria"/>
                    <ComboBoxItem Content="Docente"/>
                </ComboBox>

                <TextBlock x:Name="lblClave" Text="Contraseña (mínimo 6 caracteres) *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <PasswordBox x:Name="txtClave" Height="30" Margin="0,0,0,10" VerticalContentAlignment="Center"/>

                <TextBlock Text="Estado *" FontWeight="SemiBold" Margin="0,0,0,4"/>
                <ComboBox x:Name="cmbEstado" Height="30" Margin="0,0,0,10" SelectedIndex="0">
                    <ComboBoxItem Content="Activo"/>
                    <ComboBoxItem Content="Inactivo"/>
                </ComboBox>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button x:Name="btnCancelar" Content="Cancelar" Width="100" Height="32" Margin="0,0,10,0"
                        Background="#9CA3AF" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnCancelar_Click"/>
                <Button x:Name="btnGuardar" Content="Guardar Usuario" Width="140" Height="32"
                        Background="#10B981" Foreground="White" FontWeight="Bold" BorderThickness="0" Click="btnGuardar_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>